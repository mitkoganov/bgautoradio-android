        android:pathData="M42,58 Q42,42 54,42 Q66,42 66,58" />

    <!-- Center dot -->
    <path
        android:fillColor="#00C8E0"
        android:pathData="M54,54m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />

    <!-- Antenna line -->
